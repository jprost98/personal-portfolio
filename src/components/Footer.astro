---
const today = new Date();
---

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="logo-bracket">[</span>JP<span class="logo-bracket">]</span>
      <span class="tagline">Justin Prost — IT Audit & Cybersecurity</span>
    </div>

    <div class="footer-links">
      <a href="mailto:jprost98@gmail.com" aria-label="Email">
        <!-- Email icon -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="20" height="20">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
      </a>
      <a href="https://linkedin.com/in/justinprost" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <!-- LinkedIn icon -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/>
          <circle cx="4" cy="4" r="2"/>
        </svg>
      </a>
      <a href="https://github.com/jprost" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <!-- GitHub icon -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
        </svg>
      </a>
    </div>
  </div>

  <div class="footer-copy">
    &copy; {today.getFullYear()} Justin Prost. All rights reserved.
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    background: var(--bg-surface);
    padding: 2rem 1.5rem 1.5rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1000px;
    margin: 0 auto 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 700;
    font-size: 1em;
    color: var(--text-primary);
  }
  .logo-bracket { color: var(--accent); }

  .tagline {
    font-weight: 400;
    font-size: 0.82em;
    color: var(--text-muted);
    letter-spacing: .02em;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .footer-links a {
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    transition: color .2s;
  }
  .footer-links a:hover { color: var(--accent); }

  .footer-copy {
    text-align: center;
    font-size: 0.78em;
    color: var(--text-muted);
    max-width: 1000px;
    margin: 0 auto;
  }

  @media (max-width: 600px) {
    .footer-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
