---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Blog — ${SITE_TITLE}`}
      description="Thoughts on IT audit, cybersecurity, GRC, and the intersection of tech and law."
    />
  </head>
  <body>
    <Header />
    <main>

      <section class="blog-hero">
        <div class="blog-eyebrow">
          <span class="accent-line"></span>
          <span>Blog</span>
        </div>
        <h1>Writing</h1>
        <p class="blog-lead">
          Notes on IT audit, cybersecurity, GRC frameworks, and the evolving landscape of data privacy law.
        </p>
      </section>

      <div class="posts-list">
        {posts.map(post => (
          <a href={`/blog/${post.id}/`} class="card post-row">
            <div class="post-info">
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>
            </div>
            <div class="post-meta">
              <span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
              <span class="post-arrow">→</span>
            </div>
          </a>
        ))}

        {posts.length === 0 && (
          <p class="empty-state">No posts yet — check back soon.</p>
        )}
      </div>

    </main>
    <Footer />
  </body>
</html>

<style>
  .blog-hero {
    padding: 4rem 0 2.5rem;
  }
  .blog-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78em;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }
  .blog-eyebrow .accent-line { margin: 0; }

  .blog-hero h1 {
    font-size: clamp(2em, 5vw, 3em);
    margin-bottom: 0.4em;
    letter-spacing: -.02em;
  }
  .blog-lead {
    font-size: 1em;
    color: var(--text-secondary);
    max-width: 560px;
    line-height: 1.75;
    margin: 0;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 4rem;
  }

  .post-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    text-decoration: none;
    color: inherit;
    padding: 1.25rem 1.5rem;
  }

  .post-info { flex: 1; }
  .post-title {
    font-size: 1.05em;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.3em;
    line-height: 1.3;
    transition: color .2s;
  }
  .post-row:hover .post-title { color: var(--accent); }

  .post-desc {
    font-size: 0.87em;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  .post-date {
    font-size: 0.75em;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .post-arrow {
    color: var(--accent);
    font-size: 1em;
    opacity: 0;
    transition: opacity .2s;
  }
  .post-row:hover .post-arrow { opacity: 1; }

  .empty-state {
    color: var(--text-muted);
    font-style: italic;
    padding: 2rem 0;
  }

  @media (max-width: 600px) {
    .post-row { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
    .post-meta { flex-direction: row; align-items: center; gap: 0.75rem; }
    .post-arrow { opacity: 1; }
  }
</style>
