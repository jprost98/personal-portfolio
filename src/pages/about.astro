---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`About — ${SITE_TITLE}`}
      description="IT Audit & Cybersecurity professional — background, philosophy, and goals."
    />
  </head>
  <body>
    <Header />
    <main>

      <section class="about-hero">
        <div class="about-eyebrow">
          <span class="accent-line"></span>
          <span>About</span>
        </div>
        <h1>Hey, I'm <span class="accent">Justin</span>.</h1>
        <p class="about-lead">
          I'm an IT Audit and Cybersecurity professional with 4+ years helping organizations
          understand and manage technology risk — from state government agencies to fintech.
        </p>
      </section>

      <div class="about-grid">

        <!-- Left column — main narrative -->
        <div class="about-main">

          <div class="prose-section">
            <h2>What I do</h2>
            <p>
              My work sits at the intersection of IT audit, GRC, and security operations. I conduct
              IT general controls (ITGC) audits, assess cybersecurity posture, manage vulnerability
              programs, and build tooling to make the audit process faster and more precise.
            </p>
            <p>
              At <strong>GreenSky, LLC</strong> I lead SOX ITGC audits and evaluate cloud security
              across SaaS and Azure environments. Before that, I spent three years at the
              <strong>State of Georgia Department of Audits & Accounts</strong> where I led
              information systems audits across dozens of state agencies, ran privileged-access reviews,
              and deployed Python automation that cut manual review hours by roughly 30%.
            </p>
          </div>

          <div class="prose-section">
            <h2>How I got here</h2>
            <p>
              I studied Cybersecurity at the <strong>University of North Georgia</strong> (B.S., 3.4 GPA)
              where I was part of the Corps of Cadets — a program that instilled a disciplined, mission-first
              mindset that carries directly into how I approach audits.
            </p>
            <p>
              Early in my career I worked as a Systems Analyst and Bench Technician at
              <strong>Athens Micro</strong>, which gave me hands-on exposure to endpoints, patch management,
              and enterprise security tooling before I moved into formal audit roles.
            </p>
          </div>

          <div class="prose-section">
            <h2>Where I'm headed</h2>
            <p>
              I'm currently pursuing the <strong>Texas A&M School of Law Cybersecurity MLS Program</strong>
              with a goal of moving into data privacy advisory work. The legal and technical sides of
              privacy (GDPR, CCPA, emerging AI regulation) are converging fast, and I want to be at
              that intersection.
            </p>
            <p>
              On the technical side, I'm building out my skills in AI-assisted audit automation —
              using LLMs to accelerate evidence review, anomaly detection, and report generation.
            </p>
          </div>

          <div class="prose-section">
            <h2>Outside the work</h2>
            <p>
              When I'm not auditing or studying, I'm usually reading about emerging cybersecurity law,
              tinkering with home lab infrastructure (Docker, Wazuh, Splunk), or exploring how AI tools
              are reshaping the GRC landscape.
            </p>
          </div>
        </div>

        <!-- Right column — quick facts -->
        <aside class="about-aside">

          <div class="card aside-card">
            <h3 class="aside-title">Quick Facts</h3>
            <ul class="fact-list">
              <li>
                <span class="fact-label">Location</span>
                <span class="fact-value">Atlanta, GA</span>
              </li>
              <li>
                <span class="fact-label">Current Role</span>
                <span class="fact-value">Internal IT Auditor @ GreenSky</span>
              </li>
              <li>
                <span class="fact-label">Education</span>
                <span class="fact-value">B.S. Cybersecurity, UNG</span>
              </li>
              <li>
                <span class="fact-label">Certification</span>
                <span class="fact-value">ISC2 CC (Active)</span>
              </li>
              <li>
                <span class="fact-label">In Progress</span>
                <span class="fact-value">CompTIA CySA+</span>
              </li>
              <li>
                <span class="fact-label">Goal</span>
                <span class="fact-value">Data Privacy Advisor / Cybersecurity Law</span>
              </li>
            </ul>
          </div>

          <div class="card aside-card">
            <h3 class="aside-title">Frameworks &amp; Standards</h3>
            <ul class="tag-list">
              <li><span class="tag">NIST CSF / RMF</span></li>
              <li><span class="tag">SOX ITGC</span></li>
              <li><span class="tag">COBIT</span></li>
              <li><span class="tag">GDPR</span></li>
              <li><span class="tag">CCPA</span></li>
              <li><span class="tag">ISO 27001</span></li>
            </ul>
          </div>

          <div class="card aside-card contact-card">
            <h3 class="aside-title">Contact</h3>
            <a href="mailto:jprost98@gmail.com" class="contact-link">
              <!-- email icon -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              jprost98@gmail.com
            </a>
            <a href="https://linkedin.com/in/justinprost" target="_blank" rel="noopener noreferrer" class="contact-link">
              <!-- linkedin icon -->
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
              linkedin.com/in/justinprost
            </a>
          </div>

        </aside>
      </div>

    </main>
    <Footer />
  </body>
</html>

<style>
  .about-hero {
    padding: 4rem 0 3rem;
  }
  .about-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78em;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .about-eyebrow .accent-line { margin: 0; }

  .about-hero h1 {
    font-size: clamp(2.2em, 5vw, 3.2em);
    margin-bottom: 0.6em;
    letter-spacing: -.02em;
  }
  .accent { color: var(--accent); }

  .about-lead {
    font-size: 1.1em;
    color: var(--text-secondary);
    max-width: 620px;
    line-height: 1.75;
    margin: 0;
  }

  /* Grid layout */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 2.5rem;
    align-items: start;
  }

  /* Prose sections */
  .prose-section {
    margin-bottom: 2.5rem;
  }
  .prose-section h2 {
    font-size: 1em;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.85rem;
  }
  .prose-section p {
    color: var(--text-secondary);
    font-size: 0.97em;
    line-height: 1.8;
    margin-bottom: 0.9em;
  }
  .prose-section p strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Aside */
  .about-aside {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 80px;
  }

  .aside-card { padding: 1.25rem 1.4rem; }

  .aside-title {
    font-size: 0.73em;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.9rem;
  }

  .fact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .fact-list li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .fact-label {
    font-size: 0.7em;
    font-weight: 600;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .fact-value {
    font-size: 0.88em;
    color: var(--text-primary);
    line-height: 1.4;
  }

  .tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag-list li { display: inline-flex; }

  .contact-card { display: flex; flex-direction: column; gap: 0.65rem; }
  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85em;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color .2s;
    word-break: break-all;
  }
  .contact-link:hover { color: var(--accent); }
  .contact-link svg { flex-shrink: 0; }

  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-aside {
      position: static;
    }
    .about-hero { padding: 2.5rem 0 2rem; }
  }
</style>
