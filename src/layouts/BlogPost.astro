---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={`${title} — ${SITE_TITLE}`} description={description} image={heroImage} />
  </head>
  <body>
    <Header />
    <main class="post-main">

      <div class="post-header">
        <a href="/blog" class="back-link">← All Posts</a>
        <div class="post-meta">
          <span class="post-date"><FormattedDate date={pubDate} /></span>
          {updatedDate && (
            <span class="post-updated">
              Updated <FormattedDate date={updatedDate} />
            </span>
          )}
        </div>
        <h1>{title}</h1>
        {description && <p class="post-desc">{description}</p>}
        <hr />
      </div>

      {heroImage && (
        <div class="hero-image">
          <img src={heroImage} alt="" width={860} height={430} />
        </div>
      )}

      <article class="prose">
        <slot />
      </article>

    </main>
    <Footer />
  </body>
</html>

<style>
  .post-main {
    width: 720px;
    max-width: calc(100% - 2em);
    margin: 0 auto;
    padding: 2.5em 1em 5em;
  }

  .back-link {
    display: inline-block;
    font-size: 0.82em;
    font-weight: 600;
    letter-spacing: .04em;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 2rem;
    transition: color .2s;
  }
  .back-link:hover { color: var(--accent); }

  .post-header { margin-bottom: 2rem; }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .post-date {
    font-size: 0.78em;
    font-weight: 600;
    letter-spacing: .04em;
    color: var(--accent);
  }
  .post-updated {
    font-size: 0.75em;
    color: var(--text-muted);
    font-style: italic;
  }

  .post-header h1 {
    font-size: clamp(1.8em, 4vw, 2.6em);
    font-weight: 700;
    letter-spacing: -.02em;
    margin-bottom: 0.4em;
    line-height: 1.15;
  }
  .post-desc {
    font-size: 1.05em;
    color: var(--text-secondary);
    margin: 0 0 1.25em;
    line-height: 1.6;
  }
  .post-header hr {
    margin: 1.5em 0 0;
  }

  .hero-image {
    margin-bottom: 2.5rem;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }

  /* Prose content styles */
  .prose {
    color: var(--text-secondary);
    font-size: 1em;
    line-height: 1.8;
  }
  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    color: var(--text-primary);
    margin-top: 2em;
    margin-bottom: 0.6em;
  }
  .prose :global(h2) { font-size: 1.5em; }
  .prose :global(h3) { font-size: 1.2em; }

  .prose :global(p) { margin-bottom: 1.4em; }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-dim);
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) { color: #fff; }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5em;
    margin-bottom: 1.4em;
  }
  .prose :global(li) { margin-bottom: 0.4em; }

  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 0.5em 0 0.5em 1.25em;
    color: var(--text-secondary);
    font-style: italic;
    margin: 1.5em 0;
  }

  .prose :global(img) {
    border-radius: 6px;
    border: 1px solid var(--border);
    margin: 1.5em 0;
  }
</style>
